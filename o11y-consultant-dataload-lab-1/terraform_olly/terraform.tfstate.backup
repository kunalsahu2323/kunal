    {
      "mode": "managed",
      "type": "signalfx_detector",
      "name": "det_01",
      "provider": "provider[\"registry.terraform.io/splunk-terraform/signalfx\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "authorized_writer_teams": null,
            "authorized_writer_users": null,
            "description": "p99 Memory Utilization is high in a datacenter",
            "detector_origin": "Standard",
            "disable_sampling": false,
            "end_time": null,
            "id": "GjriCaJA4AA",
            "label_resolutions": {
              "p99 of memory by datacenter": 10000
            },
            "max_delay": 0,
            "min_delay": 0,
            "name": "KS_TF_p99 Memory by Datacenter",
            "parent_detector_id": "",
            "program_text": "A = data('memory.utilization').percentile(99, by=['datacenter']).publish()\ndetect(when(A \u003e 90,'5m'), off=when(A \u003c 50,'5m')).publish('p99 of memory by datacenter')\n",
            "rule": [
              {
                "description": "p99 of memory \u003e 90",
                "detect_label": "p99 of memory by datacenter",
                "disabled": false,
                "notifications": [],
                "parameterized_body": "",
                "parameterized_subject": "",
                "runbook_url": "",
                "severity": "Critical",
                "tip": ""
              }
            ],
            "show_data_markers": true,
            "show_event_lines": false,
            "start_time": null,
            "tags": [],
            "teams": [],
            "time_range": 3600,
            "timezone": "UTC",
            "url": "https://app.signalfx.com/#/detector/GjriCaJA4AA",
            "viz_options": []
          },
