        }
      ]
    },
    {
      "mode": "managed",
      "type": "signalfx_detector",
      "name": "det_02",
      "provider": "provider[\"registry.terraform.io/splunk-terraform/signalfx\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "authorized_writer_teams": null,
            "authorized_writer_users": null,
            "description": "High memory usage of a container",
            "detector_origin": "Standard",
            "disable_sampling": false,
            "end_time": null,
            "id": "GjrpNLHA0AA",
            "label_resolutions": {
              "container mem-critical": 10000,
              "container mem-major": 10000
            },
            "max_delay": 0,
            "min_delay": 0,
            "name": "KS_TF_Memory usage of a container",
            "parent_detector_id": "",
            "program_text": "A = data('memory.usage.limit').publish()\nB = data('memory.usage.total').publish()\nC = (100*(A-B)/A).publish()\ndetect(when(C\u003e 70,'5m')).publish('container mem-critical')\ndetect(when(50 \u003c C and C \u003c= 70,'10m')).publish('container mem-major')\n",
            "rule": [
              {
                "description": "50 \u003c mem usage \u003c 70",
                "detect_label": "container mem-major",
                "disabled": false,
                "notifications": [],
                "parameterized_body": "",
                "parameterized_subject": "",
                "runbook_url": "",
                "severity": "Major",
                "tip": ""
              },
              {
                "description": "mem usage \u003e 70",
                "detect_label": "container mem-critical",
                "disabled": false,
                "notifications": [],
                "parameterized_body": "",
                "parameterized_subject": "",
                "runbook_url": "",
                "severity": "Critical",
                "tip": ""
              }
            ],
            "show_data_markers": true,
            "show_event_lines": false,
            "start_time": null,
            "tags": [],
            "teams": [],
            "time_range": 3600,
            "timezone": "UTC",
            "url": "https://app.signalfx.com/#/detector/GjrpNLHA0AA",
            "viz_options": []
          },
          "sensitive_attributes": [],
